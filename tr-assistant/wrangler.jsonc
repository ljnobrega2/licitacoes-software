{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "licitacoes-tr-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "licitacoes-team",
      "database_id": "35adbb1d-3bbd-4b72-a8f1-2776aaba3e70",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini",
    "ALLOWED_ORIGIN": "https://ljnobrega2.github.io",
    "ALLOWED_DOCUMENT_HOSTS": "pncp.gov.br"
  }
}
