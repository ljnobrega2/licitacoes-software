{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "licitacoes-tr-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "assets": { "directory": "../app", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "licitacoes-team",
      "database_id": "35adbb1d-3bbd-4b72-a8f1-2776aaba3e70",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_VERSION": "2026.10.09-team-4"
  }
}
